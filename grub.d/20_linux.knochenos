### EndeavourOS ###
menuentry "EndeavourOS (Arch)" --class endeavouros {
    search --fs-uuid --set=root 252ff7da-ae0b-4529-8e31-2230513d1e53
    linux /boot/vmlinuz-linux root=UUID=252ff7da-ae0b-4529-8e31-2230513d1e53 rw quiet splash loglevel=3
