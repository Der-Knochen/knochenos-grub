### Debian GNU/Linux 12 (Host) ###
menuentry "Debian GNU/Linux 12 (KnochenOS)" --class debian {
    search --fs-uuid --set=root 74cff028-7695-4900-861d-3f5cae3e1f09
    linux /boot/vmlinuz root=UUID=74cff028-7695-4900-861d-3f5cae3e1f09 ro quiet splash loglevel=3
    initrd /boot/initrd.img
}

### Ubuntu / CSI Linux ###
menuentry "Ubuntu 22.04 (CSI / Forensics)" --class csi {
    search --fs-uuid --set=root eae9c8f1-1036-4018-8781-ef0a754d375b
    linux /boot/vmlinuz-6.9.9-060909-generic root=UUID=eae9c8f1-1036-4018-8781-ef0a754d375b ro quiet nomodeset
    initrd /boot/initrd.img-6.9.9-060909-generic
}

